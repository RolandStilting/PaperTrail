    "›" : {

    },
    "\"%@\" in Inbox is not a plain file (a link or a folder) and was skipped. Put the document itself in Inbox." : {

    },
    "\"%@\" is in Needs Review, but the original image could not be removed (%@). It is in Needs Review/.claimed; you can delete it there." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\"%1$@\" is in Needs Review, but the original image could not be removed (%2$@). It is in Needs Review/.claimed; you can delete it there."
          }
        }
      }
    },
    "\"%@\" is no longer in Needs Review. It was probably filed on another device. Pull down to refresh the list." : {

    },
    "\"%@\" is no longer where Paper Trail filed it. It may have been moved or renamed on another device; wait for iCloud Drive to catch up and try again." : {

    },
